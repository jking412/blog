---
import '../styles/global.css';
import { siteTitle, siteDescription } from '../lib/posts';
interface Props { title?: string; description?: string; article?: boolean; date?: Date }
const { title, description = siteDescription, article = false, date } = Astro.props;
const pageTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8f3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteTitle} />
    {date && <meta property="article:published_time" content={date.toISOString()} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header shell">
      <a class="brand" href="/" aria-label="jking の 博客首页">jking<span class="brand-dot">.</span></a>
      <nav aria-label="主导航">
        <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>文章</a>
        <a href="/archives/" aria-current={currentPath.startsWith('/archives') ? 'page' : undefined}>归档</a>
        <a href="/tags/" aria-current={currentPath.startsWith('/tags') ? 'page' : undefined}>标签</a>
        <a href="/about/" aria-current={currentPath === '/about/' ? 'page' : undefined}>关于</a>
      </nav>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="site-footer shell">
      <p>© {new Date().getFullYear()} jking <span class="footer-separator">/</span> 用文字留下思考</p>
      <div><a href="/rss.xml">RSS 订阅</a><a href="https://github.com/jking412/blog" target="_blank" rel="noreferrer">GitHub</a></div>
    </footer>
  </body>
</html>
